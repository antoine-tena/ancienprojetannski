<script setup>
definePageMeta({
  middleware: 'auth'
})

const form = ref({
  // Meta tags généraux
  site_title: '',
  site_description: '',
  keywords: '',
  
  // Open Graph
  og_title: '',
  og_description: '',
  og_image: '',
  
  // Twitter
  twitter_card_type: 'summary_large_image',
  twitter_title: '',
  twitter_description: '',
  twitter_image: '',
  
  // Robots
  robots_index: true,
  robots_follow: true,
  sitemap_url: '',
  
  // Schema.org
  schema_type: 'Organization',
  schema_name: '',
  schema_logo: ''
})

const loading = ref(false)
const error = ref('')
const success = ref('')

async function saveSEO() {
  loading.value = true
  error.value = ''
  success.value = ''

  try {
    // TODO: Implémenter l'API backend pour sauvegarder les données SEO
    // Pour l'instant, on simule la sauvegarde
    await new Promise(resolve => setTimeout(resolve, 1000))
    
    success.value = 'Configuration SEO enregistrée avec succès !'
    
    setTimeout(() => {
      success.value = ''
    }, 3000)
  } catch (err) {
    error.value = 'Erreur lors de l\'enregistrement'
    console.error(err)
  } finally {
    loading.value = false
  }
}

onMounted(async () => {
  const { ensureCsrfToken } = useAuth()
  await ensureCsrfToken()
  
  // TODO: Charger les données SEO depuis l'API
})
</script>
